// Endpoint para insertar múltiples registros desde Excel
// Convierte "DD/MM/YY" o "DD/MM/YYYY" a Date UTC
function parseExcelDateUTC(fechaStr) {
  if (!fechaStr) return null;

  // Detecta formato DD/MM/YY o DD/MM/YYYY
  const partes = fechaStr.split('/').map(Number);
  if (partes.length === 3) {
    let [d, m, y] = partes;
    if (y < 100) y += 2000; // '25' → 2025
    // Crear Date usando UTC para que no se reste un día
    return new Date(Date.UTC(y, m - 1, d));
  }

  // Si viene en formato textual "Wednesday, October 1, 2025"
  const fecha = new Date(fechaStr);
  if (!isNaN(fecha)) {
    // Convertimos a UTC manteniendo día exacto
    return new Date(Date.UTC(fecha.getFullYear(), fecha.getMonth(), fecha.getDate()));
  }

  return null;
}


function normalizeDate(dateStr) {
  if (!dateStr) return null;
  // fuerza YYYY-MM-DD como STRING, no Date
  return dateStr.toString().substring(0, 10);
}

