app.post("/estatles-actualizar-registro", async (req, res) => {
  const datos = req.body;

  try {
    // -------------------------
    // 1️⃣ Validar que venga el ID
    // -------------------------
    if (!datos.id) {
      return res.status(400).json({ error: "Falta el ID del registro a actualizar." });
    }

    const idRegistro = datos.id;
    delete datos.id; // evitar actualizar el ID

    // -------------------------
    // 2️⃣ Construir SET dinámico
    // -------------------------
    const columnas = [];
    const values = [];
    let i = 1;

    for (const key in datos) {
      if (datos[key] !== undefined && datos[key] !== null) {
        columnas.push(`${key.toLowerCase()} = $${i}`);
        values.push(datos[key]);
        i++;
      }
    }

    if (columnas.length === 0) {
      return res.status(400).json({ error: "No se enviaron datos para actualizar." });
    }

    const updateQuery = `
      UPDATE registros
      SET ${columnas.join(", ")}
      WHERE id = $${i}
      RETURNING *
    `;
    values.push(idRegistro);

    const result = await pool.query(updateQuery, values);

    if (result.rows.length === 0) {
      return res.status(404).json({ error: "Registro no encontrado." });
    }

    res.json({
      registro: result.rows[0],
      message: "✅ Registro actualizado correctamente."
    });

  } catch (err) {
    console.error("❌ Error actualizando registro:", err.message);
    res.status(500).json({ error: err.message });
  }
});

