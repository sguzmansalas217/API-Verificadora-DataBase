app.post("/folios-join", async (req, res) => {
  try {
    const { filters } = req.body; // filtros opcionales

    // Columnas fijas a seleccionar
    const selectColumns = `
      f.certificado,
      f.utilizado,
      r.usuarioactual,
      f.fechaactualizacion,
      f.linea,
      r.nombreCliente,
      r.referencia,
      r.referencia2,
      r.cantidadCredito,
      r.uso,
      r.year,
      r.estado,
      r.fechaRegistro,
      r.placa
    `;

    // Filtros dinámicos
    let filterClause = "";
    let values = [];
    if (filters && Object.keys(filters).length > 0) {
      const whereClauses = [];
      let idx = 1;
      for (const key in filters) {
        whereClauses.push(`${key} = $${idx++}`);
        values.push(filters[key]);
      }
      filterClause = "WHERE " + whereClauses.join(" AND ");
    }

    // Query con join fijo
    const query = `
      SELECT ${selectColumns}
      FROM folios f
      LEFT JOIN registros r
      ON r.certificado = f.certificado
      ${filterClause}
      ORDER BY f.certificado
    `;

    const result = await pool.query(query, values);
    res.json(result.rows);

  } catch (err) {
    console.error("❌ Error obteniendo folios con join:", err.message);
    res.status(500).json({ error: err.message });
  }
});
