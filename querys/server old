app.put("/actualizar-por-certificado", async (req, res) => {
  try {
    const { tabla, certificado, data, linea } = req.body;

    if (!tabla || !certificado || !data || Object.keys(data).length === 0) {
      return res.status(400).json({ error: "Falta tabla, certificado o datos a actualizar" });
    }

    // Construir query de UPDATE
    const setClauses = [];
    const values = [];
    let idx = 1;

    for (const key in data) {
      setClauses.push(`${key} = $${idx++}`);
      values.push(data[key]);
    }

    values.push(certificado);

    const updateQuery = `
      UPDATE ${tabla}
      SET ${setClauses.join(", ")}
      WHERE certificado = $${idx}
      RETURNING *
    `;
    const updateResult = await pool.query(updateQuery, values);

    if (updateResult.rows.length > 0) {
      return res.json({
        mensaje: `Registro actualizado correctamente en la tabla "${tabla}"`,
        registroActualizado: updateResult.rows[0]
      });
    }

    // Si quieres crear un registro nuevo, hazlo solo si el certificado **no existe**:
    const checkCertificado = await pool.query(`SELECT 1 FROM ${tabla} WHERE certificado = $1`, [certificado]);
    if (checkCertificado.rows.length === 0) {
      const insertColumns = ["certificado", ...Object.keys(data)];
      const insertValues = [certificado, ...Object.values(data)];
      if (linea) {
        insertColumns.push("linea");
        insertValues.push(linea);
      }
      const placeholders = insertValues.map((_, i) => `$${i + 1}`);
      const insertQuery = `
        INSERT INTO ${tabla} (${insertColumns.join(", ")})
        VALUES (${placeholders.join(", ")})
        RETURNING *
      `;
      const insertResult = await pool.query(insertQuery, insertValues);
      return res.json({
        mensaje: `No existía, se creó un nuevo registro en la tabla "${tabla}"`,
        registroCreado: insertResult.rows[0]
      });
    }

    return res.status(400).json({ error: "El certificado ya existe y no se puede insertar duplicado." });

  } catch (err) {
    console.error("❌ Error actualizando o creando registro:", err.message);
    res.status(500).json({ error: err.message });
  }
});


