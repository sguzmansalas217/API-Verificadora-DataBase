// guarda un registro completo 
app.post("/registro-guardar", async (req, res) => {
  const datos = req.body;

  try {
    // -------------------------
    // 0️⃣ Validar certificado único
    // -------------------------
    if (datos.Certificado && !datos.CertificadoOk) {
      const { rows } = await pool.query(
        `SELECT 1 FROM registros WHERE certificado = $1`,
        [datos.Certificado]
      );
      if (rows.length > 0) {
        return res.status(400).json({ error: "Este certificado ya fue utilizado." });
      }
    }

    // -------------------------
    // 1️⃣ Construir INSERT dinámico para "registros" (sin 'Linea' ni 'id')
    // -------------------------
    const columnas = [];
    const placeholders = [];
    const values = [];

    let i = 1;
    for (const key in datos) {
      if (datos[key] !== undefined && datos[key] !== null && key.toLowerCase() !== "linea" && key.toLowerCase() !== "id") {
        columnas.push(key.toLowerCase());
        placeholders.push(`$${i}`);
        values.push(datos[key]);
        i++;
      }
    }

    if (columnas.length === 0) {
      return res.status(400).json({ error: "No se enviaron datos para guardar." });
    }

    const insertQuery = `
      INSERT INTO registros(${columnas.join(",")})
      VALUES(${placeholders.join(",")})
      RETURNING *
    `;
    const insertResult = await pool.query(insertQuery, values);
    const registroId = insertResult.rows[0].id;

    // -------------------------
    // 2️⃣ Actualizar folio dinámicamente si CertificadoOk = false y Certificado no es nulo
    // -------------------------
    if (!datos.CertificadoOk && datos.Certificado) {
      const updateCols = ["utilizado = TRUE"];
      const updateValues = [];
      let j = 1;

      if (datos.fechaactualizacion) { updateCols.push(`fechaactualizacion = $${j++}`); updateValues.push(datos.fechaactualizacion); }
      if (datos.Linea) { updateCols.push(`linea = $${j++}`); updateValues.push(datos.Linea); }
      if (datos.UsuarioActual) { updateCols.push(`usuarioactual = $${j++}`); updateValues.push(datos.UsuarioActual); }
      updateCols.push(`id_registro = $${j++}`); updateValues.push(registroId);

      const updateFolioQuery = `
        UPDATE folios
        SET ${updateCols.join(", ")}
        WHERE certificado = $${j}
        RETURNING *
      `;
      updateValues.push(datos.Certificado);

      await pool.query(updateFolioQuery, updateValues);
    }

    res.json({ registro: insertResult.rows[0], message: "Registro guardado correctamente" });

  } catch (err) {
    console.error("❌ Error guardando registro:", err.message);
    res.status(500).json({ error: err.message });
  }
});
