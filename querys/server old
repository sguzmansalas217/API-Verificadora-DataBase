// 🔹 Agregar varios folios nuevos a la tabla "folios"
app.post("/agregar-folios", async (req, res) => {
  try {
    const { certificados } = req.body;

    if (!Array.isArray(certificados) || certificados.length === 0) {
      return res.status(400).json({
        error: "Debe enviar un arreglo de certificados"
      });
    }

    let foliosAgregados = [];
    let foliosDuplicados = [];

    for (const certificado of certificados) {
      try {
        const result = await pool.query(
          `
          INSERT INTO folios (certificado, utilizado, usuarioactual, fechaactualizacion)
          VALUES ($1, false, NULL, NULL)
          RETURNING *
          `,
          [certificado]
        );

        foliosAgregados.push(result.rows[0]);
      } catch (err) {
        if (err.code === '23505') {
          foliosDuplicados.push(certificado);
        } else {
          throw err;
        }
      }
    }

    res.json({
      mensaje: `✅ Proceso terminado`,
      foliosAgregados,
      foliosDuplicados
    });

  } catch (err) {
    console.error("❌ Error agregando folios:", err);
    res.status(500).json({ error: "Error agregando folios" });
  }
});




